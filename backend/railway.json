{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "DJANGO_SETTINGS_MODULE=config.settings.production python manage.py migrate --noinput; DJANGO_SETTINGS_MODULE=config.settings.production daphne -b 0.0.0.0 -p $PORT config.asgi:application",
    "healthcheckPath": "/api/health/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
